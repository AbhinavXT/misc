#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

typedef enum { LOCO_WAP7 = 0, LOCO_WAG9, LOCO_WAP5, LOCO_COUNT } LocoType;
typedef enum { MODE_LEM  = 0, MODE_FORMATION,       MODE_COUNT } Mode;
typedef enum { CMD_NB    = 0, CMD_FS, CMD_EB,       CMD_COUNT  } Command;

typedef struct { float min; float max; } Range;

#define RANGE_TOL(nom, t)   { (float)((nom) - (t)), (float)((nom) + (t)) }
#define RANGE_UPPER(m)      { 0.0f, (float)(m) }
#define RANGE_BETWEEN(a, b) { (float)(a), (float)(b) }

/* Everything needed to validate any checkpoint for a (loco, mode, command). */
typedef struct {
    Range mr;          /* Main Reservoir baseline                */
    Range bp_charged;  /* BP at rest, brake released             */
    Range bp;          /* BP target after this command           */
    Range bc;          /* BC target after this command           */
    Range t_apply;     /* Application timing                     */
    Range t_release;   /* Release timing                         */
} BrakeSpec;

/* MR and bp_charged repeat across mode/command — that's the tradeoff. */
