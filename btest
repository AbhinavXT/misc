            [CMD_FS] = { MR_STD, BP_CHARGED_STD, RANGE_TOL(3.5f,0.2f), RANGE_TOL(3.5f,0.1f), RANGE_UPPER(8), RANGE_UPPER(60)        },
            [CMD_EB] = { MR_STD, BP_CHARGED_STD, RANGE_UPPER(0.3f),    RANGE_TOL(3.5f,0.1f), RANGE_UPPER(8), RANGE_BETWEEN(45,60)   },
