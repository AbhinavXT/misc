/* --- Helpers --- */
static inline float range_nominal(Range r)           { return (r.min + r.max) * 0.5f; }
static inline bool  range_contains(Range r, float v) { return v >= r.min && v <= r.max; }
static inline bool  range_contains_tol(Range r, float v, float tol) {
    return v >= (r.min - tol) && v <= (r.max + tol);
}

static inline const BrakeSpec *brake_spec_get(LocoType loco, Mode mode, Command cmd) {
    if (loco >= LOCO_COUNT || mode >= MODE_COUNT || cmd >= CMD_COUNT) return NULL;
    return &kBrakeTable[loco][mode][cmd];
}